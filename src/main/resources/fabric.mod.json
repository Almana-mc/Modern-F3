{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": ["${mod_authors}"],
  "license": "${mod_license}",
  "environment": "client",
  "entrypoints": {
    "client": ["me.almana.modern_f3.client.FabricClientInit"]
  },
  "mixins": [
    {
      "config": "${mod_id}.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "fabric-api": "*",
    "minecraft": ">=26.1",
    "java": ">=21"
  }
}
